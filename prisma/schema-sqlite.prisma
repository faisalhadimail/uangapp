// SQLite schema (for reading old data during migration)
// This is a copy of the schema with sqlite provider

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client-sqlite"
}

datasource db {
  provider = "sqlite"
  url      = env("SQLITE_URL")
}

// All models must match the main schema exactly
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  familyMemberId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sessions Session[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

model Category {
  id        String   @id @default(cuid())
  name      String
  type      String
  color     String   @default("#10b981")
  icon      String   @default("Wallet")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  transactions Transaction[]
  budgets      Budget?
}

model Account {
  id             String   @id @default(cuid())
  name           String
  type           String   @default("cash")
  initialBalance Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  transactionsFrom Transaction[] @relation("TransactionsFromAccount")
  transactionsTo   Transaction[] @relation("TransactionsToAccount")
}

model Transaction {
  id          String   @id @default(cuid())
  type        String
  amount      Int
  description String
  date        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  accountId     String
  account       Account   @relation("TransactionsFromAccount", fields: [accountId], references: [id])
  toAccountId    String?
  toAccount      Account? @relation("TransactionsToAccount", fields: [toAccountId], references: [id], onDelete: SetNull)
  memberId      String?
  member        FamilyMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  @@index([date])
  @@index([type])
  @@index([categoryId])
  @@index([memberId])
}

model Budget {
  id         String   @id @default(cuid())
  categoryId String   @unique
  amount     Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model Saving {
  id            String   @id @default(cuid())
  name          String
  type          String   @default("goal")
  targetAmount  Int
  currentAmount Int      @default(0)
  targetDate    String?
  color         String   @default("#10b981")
  icon          String   @default("PiggyBank")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Bill {
  id          String   @id @default(cuid())
  name        String
  amount      Int
  dueDay      Int
  recurrence  String   @default("monthly")
  color       String   @default("#0ea5e9")
  icon        String   @default("Receipt")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  paidRecords PaidBill[]
}

model PaidBill {
  id      String   @id @default(cuid())
  billId  String
  month   String
  paidAt  DateTime @default(now())
  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)
  @@unique([billId, month])
}

model Debt {
  id          String   @id @default(cuid())
  type        String
  personName  String
  amount      Int
  description String
  dueDate     String?
  isPaid      Boolean  @default(false)
  paidDate    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([type])
  @@index([isPaid])
}

model WhatsAppTemplate {
  id        String   @id @default(cuid())
  name      String
  body      String
  reportType String  @default("monthly")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  scheduledReports ScheduledReport[]
}

model WhatsAppRecipient {
  id        String   @id @default(cuid())
  name      String
  phone     String
  role      String   @default("spouse")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ScheduledReport {
  id           String   @id @default(cuid())
  name         String
  frequency    String   @default("monthly")
  dayOfWeek    Int      @default(1)
  hour         Int      @default(8)
  minute       Int      @default(0)
  nextRunAt    String
  isActive     Boolean  @default(true)
  templateId   String?
  template     WhatsAppTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  recipientIds String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  logs ScheduledReportLog[]
}

model ScheduledReportLog {
  id              String   @id @default(cuid())
  scheduledReportId String
  sentAt          String
  status          String   @default("sent")
  preview         String   @default("")
  scheduledReport ScheduledReport @relation(fields: [scheduledReportId], references: [id], onDelete: Cascade)
  @@index([scheduledReportId])
}

model FamilyMember {
  id          String   @id @default(cuid())
  name        String
  role        String   @default("editor")
  color       String   @default("#10b981")
  avatar      String   @default("")
  isActive    Boolean  @default(true)
  isCurrentUser Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  transactions Transaction[]
  notifications Notification[]
}

model Notification {
  id        String   @id @default(cuid())
  type      String
  title     String
  message   String
  color     String   @default("#0ea5e9")
  actionUrl String?
  createdAt String
  readAt    String?
  priority  String   @default("normal")
  memberId  String?
  member    FamilyMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  @@index([memberId])
  @@index([readAt])
  @@index([type])
}

model FinancialInsight {
  id          String   @id @default(cuid())
  type        String
  title       String
  description String
  color       String   @default("#0ea5e9")
  value       Int?
  maxValue    Int?
  month       String
  createdAt   String
  dismissedAt String?
}

model FinancialTarget {
  id           String   @id @default(cuid())
  name         String
  type         String   @default("custom")
  targetAmount Int
  currentAmount Int     @default(0)
  targetDate   String?
  monthlyContribution Int?
  color        String   @default("#10b981")
  icon         String   @default("Target")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model BackupRecord {
  id          String   @id @default(cuid())
  createdAt   String
  filename    String
  sizeBytes   Int
  recordCount Int
  trigger     String   @default("manual")
  note        String?
}

model ReceiptScan {
  id          String   @id @default(cuid())
  createdAt   String
  filename    String
  merchant    String?
  totalAmount Int?
  date        String?
  suggestedCategory String?
  status      String   @default("pending")
  transactionId String?
}
